{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::253490771520:oidc-provider/oidc.eks.ap-south-1.amazonaws.com/id/CLUSTER_OIDC_ID"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
                "StringEquals": {
                    "oidc.eks.ap-south-1.amazonaws.com/id/CLUSTER_OIDC_ID:sub": "system:serviceaccount:default:catalog-sa"
                }
            }
        }
    ]
}